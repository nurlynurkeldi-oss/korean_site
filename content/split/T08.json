  "grammar": [
    {
      "name": [
        "Суффикс намерения/предположения",
        "意志/推测词缀"
      ],
      "desc": [
        "Выражает решимость или намерение говорящего; в утвердительном предложении 1-го лица означает «я хотел бы ~», в вопросительном — вежливый вопрос о желании слушающего.",
        "表示说话人的决心或意愿；第一人称陈述句意为「我想……」，疑问句用于询问对方的意愿。"
      ],
      "rule": [
        "К корню глагола присоединяется -겠-, затем суффикс. Например: 먹 + 겠습니다 → 먹겠습니다.",
        "动词词根接 -겠-，再接词尾。例如：먹 + 겠습니다 → 먹겠습니다。"
      ],
      "examples": [
        {
          "ru": "Я буду с бибимбап.",
          "zh": "我要拌饭。"
        },
        {
          "ru": "Каират, что вы будете (есть)?",
          "zh": "凯拉特，您要点什么？"
        },
        {
          "ru": "Вечером я позвоню.",
          "zh": "我晚上会打电话。"
        },
        {
          "ru": "Я не пойду на вечеринку.",
          "zh": "我不去参加聚会。"
        }
      ]
    },
    {
      "name": [
        "Отрицание",
        "否定"
      ],
      "desc": [
        "Используется для образования отрицания глаголов и прилагательных.",
        "用于构成动词和形容词的否定。"
      ],
      "rule": [
        "К корню глагола/прилагательного присоединяется -지 않다. Например: 먹다 → 먹지 않다, 좋다 → 좋아하지 않다.",
        "动词/形容词词根接 -지 않다。例如：먹다 → 먹지 않다，좋다 → 좋아하지 않다。"
      ],
      "examples": [
        {
          "ru": "По воскресеньям я не хожу в школу.",
          "zh": "星期天我不去学校。"
        },
        {
          "ru": "Эта еда не солёная.",
          "zh": "这道菜不咸。"
        },
        {
          "ru": "Вчера я не встретил друга.",
          "zh": "昨天我没见朋友。"
        },
        {
          "ru": "Одежда не красивая.",
          "zh": "衣服不好看。"
        }
      ]
    },
    {
      "name": [
        "Предложение; просьба",
        "建议；请求"
      ],
      "desc": [
        "В вежливом стиле речи выражает просьбу или предложение.",
        "在敬语语体中表示请求或建议。"
      ],
      "rule": [
        "Если корень заканчивается на гласный или ㄹ, присоединяется -세요, если на согласный — -으세요. Например: 앉 + 으세요 → 앉으세요.",
        "词根以元音或ㄹ结尾时加 -세요，以辅音结尾时加 -으세요。例如：앉 + 으세요 → 앉으세요。"
      ],
      "examples": [
        {
          "ru": "Садитесь сюда.",
          "zh": "请坐在这里。"
        },
        {
          "ru": "Дайте, пожалуйста, немного воды.",
          "zh": "请给我一点水。"
        },
        {
          "ru": "Подождите немного.",
          "zh": "请稍等。"
        },
        {
          "ru": "Добро пожаловать.",
          "zh": "欢迎光临。"
        }
      ]
    },
    {
      "name": [
        "Неправильные слова «ㅂ»",
        "「ㅂ」不规则词"
      ],
      "desc": [
        "В словах с корнем на ㅂ согласный ㅂ перед гласным переходит в о/у.",
        "词根以ㅂ结尾的词，ㅂ 在元音前变为о/у。"
      ],
      "rule": [
        "В корнях на ㅂ перед гласным ㅂ переходит в о или у: 어렵다 → 어려워요, 아름답다 → 아름다워요, 고맙다 → 고마워요.",
        "ㅂ结尾的词根在元音前 ㅂ 变为о或у：어렵다 → 어려워요，아름답다 → 아름다워요，고맙다 → 고마워요。"
      ],
      "examples": [
        {
          "ru": "Кимчи-чхигэ немного острый.",
          "zh": "泡菜汤有点辣。"
        },
        {
          "ru": "Наша мама красивая.",
          "zh": "我的妈妈很漂亮。"
        },
        {
          "ru": "Корейский язык трудный.",
          "zh": "韩语很难。"
        }
      ]
    }
  ],
