  "grammar": [
    {
      "pattern": "-겠-",
      "nameKk": "Мұқият/болжам жұрнағы",
      "nameRu": "Суффикс намерения/предположения",
      "nameZh": "意志/推测词缀",
      "descKk": "Сөйлеушінің мұқиятының немесе қалауының білдіреді; 1-жақ айтыс сөйлемде «мен ~-п едім», сұрақ сөйлемде тыңдаушының қалауын сұрау мағынасында.",
      "descRu": "Выражает решимость или намерение говорящего; в утвердительном предложении 1-го лица означает «я хотел бы ~», в вопросительном — вежливый вопрос о желании слушающего.",
      "descZh": "表示说话人的决心或意愿；第一人称陈述句意为「我想……」，疑问句用于询问对方的意愿。",
      "ruleKk": "Қағида: етістік тамырына -겠- жалғанып, жұрнақ жалғанады. Мысалы: 먹 + 겠습니다 → 먹겠습니다.",
      "ruleRu": "К корню глагола присоединяется -겠-, затем суффикс. Например: 먹 + 겠습니다 → 먹겠습니다.",
      "ruleZh": "动词词根接 -겠-，再接词尾。例如：먹 + 겠습니다 → 먹겠습니다。",
      "examples": [
        {
          "ko": "저는 비빔밥을 먹겠습니다.",
          "kk": "Мен бибимпаб жеуге едім",
          "ru": "Я буду с бибимбап.",
          "zh": "我要拌饭。"
        },
        {
          "ko": "카이라트 씨는 무엇을 드시겠어요?",
          "kk": "Кайрат не ішуге (жеуге) еді?",
          "ru": "Каират, что вы будете (есть)?",
          "zh": "凯拉特，您要点什么？"
        },
        {
          "ko": "저녁에 전화하겠습니다.",
          "kk": "Кешке қоңырау соғамын",
          "ru": "Вечером я позвоню.",
          "zh": "我晚上会打电话。"
        },
        {
          "ko": "저는 파티에 안 가겠어요.",
          "kk": "Мен тойға бармаймын",
          "ru": "Я не пойду на вечеринку.",
          "zh": "我不去参加聚会。"
        }
      ]
    },
    {
      "pattern": "-지 않다",
      "nameKk": "Екпе",
      "nameRu": "Отрицание",
      "nameZh": "否定",
      "descKk": "Етістік пен сипаттауыштардың екемесін жасау үшін қолданылады.",
      "descRu": "Используется для образования отрицания глаголов и прилагательных.",
      "descZh": "用于构成动词和形容词的否定。",
      "ruleKk": "Қағида: етістік/сипаттауыш тамырына -지 않다 жалғанады. Мысалы: 먹다 → 먹지 않다, 좋다 → 좋아하지 않다.",
      "ruleRu": "К корню глагола/прилагательного присоединяется -지 않다. Например: 먹다 → 먹지 않다, 좋다 → 좋아하지 않다.",
      "ruleZh": "动词/形容词词根接 -지 않다。例如：먹다 → 먹지 않다，좋다 → 좋아하지 않다。",
