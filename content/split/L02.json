  "grammar": [
    {
      "pattern": "이/가",
      "nameKk": "Субъектіні көрсететін жұрнақ",
      "nameRu": "Частица подлежащего",
      "nameZh": "主语标记助词",
      "descKk": "Зат есімге жалғанып, оның сөйлемде бастауыш ретінде шығатынын көрсетеді.",
      "descRu": "Присоединяется к существительному и показывает, что оно выступает в предложении в качестве подлежащего.",
      "descZh": "接在名词后，表示它在句中作主语。",
      "ruleKk": "Қағида: сөз дауыссызбен (бадыммен) аяқталса -이, дауыстымен аяқталса -가 жалғанады.",
      "ruleRu": "Слово, оканчивающееся на согласную (бэчжим), получает -이; оканчивающееся на гласную — -가.",
      "ruleZh": "单词以辅音（收音）结尾时加 -이，以元音结尾时加 -가。",
      "examples": [
        {
          "ko": "책상이 있어요.",
          "kk": "Кітап үстелі бар.",
          "ru": "Есть стол.",
          "zh": "有桌子。"
        },
        {
          "ko": "의자가 없어요.",
          "kk": "Стул жоқ.",
          "ru": "Нет стула.",
          "zh": "没有椅子。"
        },
        {
          "ko": "사전이 있어요?",
          "kk": "Сөздік бар ма?",
          "ru": "Есть словарь?",
          "zh": "有词典吗？"
        },
        {
          "ko": "아니요, 사전이 없어요.",
          "kk": "Жоқ, сөздік жоқ.",
          "ru": "Нет, словаря нет.",
          "zh": "没有，没有词典。"
        }
      ]
    },
    {
      "pattern": "도",
      "nameKk": "«де», «сонымен қатар» көрсеткіші",
      "nameRu": "Маркер «также, тоже»",
      "nameZh": "「也、同样」标记",
      "descKk": "Зат есімге жалғанып «сонымен қатар, де, сондай-ақ» мағынасын береді.",
      "descRu": "Присоединяется к существительному и передаёт значение «также, тоже, равно как и».",
      "descZh": "接在名词后，表示「也、同样」。",
      "ruleKk": "Қағида: зат есімге -도 жалғанады; бадым болсын, болмасын пішіні өзгермейді.",
      "ruleRu": "К существительному прибавляется -도; форма не меняется независимо от наличия бэчжима.",
      "ruleZh": "名词后加 -도；无论有没有收音，形式都不变。",
      "examples": [
        {
          "ko": "연필이 있어요. 지우개도 있어요.",
          "kk": "Қалам бар. Ластик те бар.",
          "ru": "Есть карандаш. Есть и ластик.",
          "zh": "有铅笔。也有橡皮。"
        },
        {
          "ko": "카이라트 씨가 있어요. 마지나 씨도 있어요.",
          "kk": "Қайрат мырза бар. Мадина мырза да бар.",
          "ru": "Кайрат-сан здесь. Мадина-сан тоже здесь.",
          "zh": "凯拉特先生在。玛迪娜女士也在。"
        },
        {
          "ko": "네, 우체국도 있어요.",
          "kk": "Иә, пошта бөлімшесі де бар.",
          "ru": "Да, есть и почтовое отделение.",
          "zh": "是的，也有邮局。"
        }
      ]
    },
    {
      "pattern": "에 있어요/없어요",
      "nameKk": "Орын көрсету: «бар/жоқ»",
      "nameRu": "Показание места: «есть/нет»",
      "nameZh": "表示处所：「有/没有」",
      "descKk": "Заттың немесе адамның қай жерде екенін көрсетеді. 있어요 — 있다 сөзінің құрметті формасы (бар), 없어요 — жоқ.",
      "descRu": "Показывает, где находится предмет или человек. 있어요 — вежливая форма слова 있다 (есть), 없어요 — нет.",
      "descZh": "表示某物或某人在什么地方。있어요 是 있다 的敬语形式（有），없어요 — 没有。",
      "ruleKk": "Қағида: орын + 에 + зат + 이/가 + 있어요 (бар) / 없어요 (жоқ).",
      "ruleRu": "Место + 에 + предмет + 이/가 + 있어요 (есть) / 없어요 (нет).",
      "ruleZh": "处所 + 에 + 名词 + 이/가 + 있어요（有）/ 없어요（没有）。",
      "examples": [
        {
          "ko": "여기에 병원이 있어요.",
          "kk": "Мұнда аурухана бар.",
          "ru": "Здесь есть больница.",
          "zh": "这里有一家医院。"
        },
        {
          "ko": "의자가 교실에 있어요.",
          "kk": "Сабақ бөлмесінде стул бар.",
          "ru": "В классе есть стул.",
          "zh": "教室里有一把椅子。"
        },
        {
          "ko": "교실에 컴퓨터가 있어요?",
          "kk": "Сабақ бөлмесінде компьютер бар ма?",
          "ru": "В классе есть компьютер?",
          "zh": "教室里有电脑吗？"
        },
        {
          "ko": "아니요, 없어요.",
          "kk": "Жоқ, жоқ.",
          "ru": "Нет, нет.",
          "zh": "不，没有。"
        }
      ]
    },
    {
      "pattern": "이/가 아니에요",
      "nameKk": "Теңдіктің терісі: «емес»",
      "nameRu": "Отрицание суждения: «не»",
      "nameZh": "判断句的否定：「不是」",
      "descKk": "Теңдік фактісін терістейді; 아니에요 — 아니다 сөзінің құрметті формасы.",
      "descRu": "Отрицает факт тождества; 아니에요 — вежливая форма слова 아니다.",
      "descZh": "对等同（判断）事实进行否定；아니에요 是 아니다 的敬语形式。",
      "ruleKk": "Қағида: терістелетін зат есімге 이/가 жалғанады + 아니에요.",
      "ruleRu": "К отрицаемому существительному прибавляется 이/가 + 아니에요.",
      "ruleZh": "被否定的名词后加 이/가 + 아니에요。",
      "examples": [
        {
          "ko": "저것은 컴퓨터가 아니에요.",
          "kk": "Сол — компьютер емес.",
          "ru": "Это не компьютер.",
          "zh": "那个不是电脑。"
        },
        {
          "ko": "여기는 백화점이 아니에요.",
          "kk": "Бұл жер — үлкен дүкен емес.",
          "ru": "Это место — не торговый центр.",
          "zh": "这里不是百货商店。"
        },
        {
          "ko": "저것은 사전이에요?",
          "kk": "Сол — сөздік пе?",
          "ru": "Это словарь?",
          "zh": "那个是词典吗？"
        },
        {
          "ko": "아니요, 사전이 아니에요. 책이에요.",
          "kk": "Жоқ, сөздік емес. Кітап.",
          "ru": "Нет, это не словарь. Это книга.",
          "zh": "不是词典，是书。"
        }
      ]
    }
  ],
  "dialogue": {
