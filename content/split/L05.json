  "grammar": [
    {
      "pattern": "-았/었-",
      "nameKk": "Өткен шақ жұрнағы",
      "nameRu": "Окончание прошедшего времени",
      "nameZh": "过去时词尾",
      "descKk": "Өткенде орындалған іс-әрекетті немесе күйді білдіреді. -아/어요 аяқталуымен бірігінде: -았어요/-었어요.",
      "descRu": "Выражает действие или состояние, происходившие в прошлом. В сочетании с окончанием -아/эо: -аттэо/-эоттэо.",
      "descZh": "表示过去发生的动作或状态。与结束形 -아/어요 结合为：-았어요/-었어요。",
      "ruleKk": "Қағида: түбір а/о дауыстысымен аяқталса -았-, қалған жағдайда -었- жалғанады; -하다 етістіктеріне -했어요: 공부하다 → 공부했어요.",
      "ruleRu": "Если корень заканчивается на гласную а/о — присоединяется -атт-, в остальных случаях — -эотт-; к глаголам на -хада присоединяется -хаэттэо: студыхада → студыхаэттэо.",
      "ruleZh": "词根以元音 а/о 结尾加 -았-，否则加 -었-；对 -하다 动词用 -했어요：공부하다 → 공부했어요。",
      "examples": [
        {
          "ko": "극장에 사람들이 많았어요.",
          "kk": "Театрда адамдар көп болды.",
          "ru": "В театре было много людей.",
          "zh": "剧院里人很多。"
        },
        {
          "ko": "아침에 책을 읽었어요.",
          "kk": "Таңертең кітап оқыдым.",
          "ru": "(Я) читал(а) книгу утром.",
          "zh": "早上我读了书。"
        },
        {
          "ko": "어제 무엇을 했어요?",
          "kk": "Кеше не істедіңіз?",
          "ru": "Что вы делали вчера?",
          "zh": "你昨天做了什么？"
        },
        {
          "ko": "친구하고 운동을 했어요.",
          "kk": "Досыммен спортпен айналыстым.",
          "ru": "(Я) занимался(лась) спортом с другом.",
          "zh": "我和朋友一起运动了。"
        }
      ]
    },
    {
      "pattern": "에 가다/오다/다니다",
      "nameKk": "Орынға бару: «бару/келу/барып-келу»",
      "nameRu": "Движение к месту: «идти/приходить/посещать»",
      "nameZh": "去某地：「去/来/常去（上学、上班）」",
      "descKk": "Бір орыннан екінші орынға қозғалуды білдіреді: 가다 — бару, 오다 — келу, 다니다 — барып-келу (жұмыс/оқу).",
      "descRu": "Выражает движение из одного места в другое: гада — идти, ода — приходить, данита — посещать (работа/учёба).",
      "descZh": "表示从一个地方到另一个地方的移动：가다 — 去，오다 — 来，다나다 — 常去（工作/学习）。",
      "ruleKk": "Қағида: орын + 에 + 가다/오다/다니다.",
      "ruleRu": "Место + Э + Гада/Ода/Данита.",
      "ruleZh": "地点 + 에 + 가다/오다/다나다。",
      "examples": [
        {
          "ko": "시장에 가요.",
          "kk": "Базарға барамын.",
          "ru": "(Я) иду на рынок.",
          "zh": "我去市场。"
        },
        {
          "ko": "저녁에 친구가 집에 와요.",
          "kk": "Кешке досым үйге келеді.",
          "ru": "Вечером мой друг приходит домой.",
          "zh": "晚上朋友回到家。"
        },
        {
          "ko": "저는 회사에 다녀요.",
          "kk": "Мен компанияда жұмыс істеймін (компанияға барып-келемін).",
          "ru": "(Я) работаю в компании (регулярно туда хожу и прихожу обратно).",
          "zh": "我在公司上班（去公司又回来）。"
        }
      ]
    },
    {
      "pattern": "안",
      "nameKk": "Терістеу: «емес», «...п кетпеу»",
      "nameRu": "Отрицание: «не»",
      "nameZh": "否定：「不」",
      "descKk": "«Емес» мағынасындағы терістеу сөзше; етістік пен сын есімнің алдына қойылады.",
      "descRu": "Отрицательное слово в значении «не»; ставится перед глаголами и прилагательными.",
      "descZh": "表示「不」的否定副词，放在动词和形容词前面。",
      "ruleKk": "Қағида: -안 етістік/сын есімнің алдына қойылады; -하다 сөздерінде зат есім мен 하다 арасына орналасады: 쇼핑을 안 해요.",
      "ruleRu": "ан ставится перед глаголом/прилагательным; в словах на -хада располагается между существительным и хада: сопингуль ан хаyo.",
      "ruleZh": "안 放在动词/形容词前；对 -하다 词放在名词和 하다 之间：쇼핑을 안 해요。",
      "examples": [
        {
          "ko": "오늘 학교에 안 가요.",
          "kk": "Бүгін мектепке бармаймын.",
          "ru": "(Я) сегодня не иду в школу.",
          "zh": "我今天不去学校。"
        },
        {
          "ko": "가방이 안 싸요.",
          "kk": "Сөмке арзан емес.",
          "ru": "Сумка не дешёвая.",
          "zh": "包不便宜。"
        },
        {
          "ko": "친구를 안 만났어요.",
          "kk": "Досыммен кездеспедім.",
          "ru": "(Я) не встречался(лась) с другом.",
          "zh": "我没有见朋友。"
        }
      ]
    },
    {
      "pattern": "쯤",
      "nameKk": "«шамамен»",
      "nameRu": "«примерно»",
      "nameZh": "「左右、大约」",
      "descKk": "Зат есімге (әсіресе уақыт сөздеріне) жалғанып «шамамен, болжаммен» мағынасын береді.",
      "descRu": "Настаивается на существительных (особенно на словах времени) и даёт значение «примерно, приблизительно».",
      "descZh": "附着在名词（尤其是时间词）后，表示「大约、大概」。",
      "ruleKk": "Қағида: уақыт/сан + 쯤.",
      "ruleRu": "Время/число + Чум.",
      "ruleZh": "时间/数字 +쯤。",
      "examples": [
        {
          "ko": "10월쯤 한국에 왔어요.",
          "kk": "Қазанда шамамен Кореяға келдім.",
          "ru": "(Я) приехал(приехала) в Корею примерно в октябре.",
          "zh": "我大概十月来的韩国。"
        },
        {
          "ko": "교실에 의자가 10개쯤 있어요.",
          "kk": "Сабақ бөлмесінде шамамен 10 стул бар.",
          "ru": "В классе примерно 10 стульев.",
          "zh": "教室里大概有10把椅子。"
        },
        {
          "ko": "다음 주쯤 가요.",
          "kk": "Келесі апта шамамен барамын.",
          "ru": "(Я) поеду примерно на следующей неделе.",
          "zh": "我大概下周去。"
        }
      ]
    }
  ],
  "dialogue": {
    "titleKk": "Демалыс күндері",
    "titleRu": "Выходные",
    "titleZh": "周末",
    "lines": [
      {
        "who": "카이라트",
        "ko": "주말에 무엇을 했어요?",
        "kk": "Демалыста не істедіңіз?",
        "ru": "Что вы делали в выходные?",
        "zh": "你周末做了什么？"
      },
      {
        "who": "마지나",
        "ko": "시장에 갔어요. 시장에서 배하고 채소를 샀어요.",
        "kk": "Базарға бардым. Базардан алмұрт пен көкөніс алдым.",
        "ru": "(Я) пошёл(а) на рынок. Купил(а) на рынке груши и овощи.",
        "zh": "我去了市场。在市场上买了梨和蔬菜。"
      },
      {
        "who": "카이라트",
        "ko": "그래요? 사과도 샀어요?",
        "kk": "Шынымен де? Алманы да алдыңыз ба?",
        "ru": "Правда? Вы купили и яблоки?",
        "zh": "是吗？苹果也买了？"
      },
      {
        "who": "마지나",
        "ko": "아니요, 사과는 안 샀어요. 카이라트 씨는 주말에 무엇을 했어요?",
        "kk": "Жоқ, алма алмадым. Сіз не істедіңіз, Қайрат-сан?",
        "ru": "Нет, яблоки не покупала. Что вы делали, Кайрат-сан?",
        "zh": "不，我没买苹果。凯拉特先生，你周末做了什么？"
      },
      {
        "who": "카이라트",
        "ko": "저는 친구를 만났어요.",
        "kk": "Мен досыммен кездестім.",
        "ru": "(Я) встретился с другом.",
        "zh": "我见了朋友。"
      }
    ]
  },
  "cultureKk": "Кореяда тойлар әдетте қонақүйлерде, той залдарында, сонымен қатар шіркеулер мен соборларда өтеді. Жас күйеу костюм киіп, жас жұмақ ақ той көйлегін киеді, сонымен қатар ата-ана мен туыстарына дәстүрлі ханбок киіп ісқал жасайды. Туыстарымен және достарымен той жасайды, той аяқталғаннан кейін жұп балалық саяжарға (honeymoon) шығады.",
  "cultureRu": "В Корее праздники обычно проходят в отелях, в банкетных залах, а также в церквях и соборах. Молодой жених надевает костюм, молодая невеста — белое свадебное платье, при этом перед родителями и родственниками они в традиционных 한복 совершают поклон. Празднуют вместе с родственниками и друзьями; после завершения праздника пара отправляется в медовый месяц.",
  "cultureZh": "在韩国的婚礼通常在酒店、宴会厅以及教堂和大教堂里举行。新郎穿西装，新娘穿白色婚纱，同时还要穿上传统한복向父母和亲属行礼。与亲人和朋友一起庆祝，婚礼结束后新婚夫妇去度蜜月。",
