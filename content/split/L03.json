  "grammar": [
    {
      "pattern": "-아/어요",
      "nameKk": "Құрметті әңгімелесу сөйлем аяқталуы",
      "nameRu": "Окончание вежливого разговорного стиля",
      "nameZh": "敬语对话体终结词尾",
      "descKk": "Әңгімелесу сөйлеудегі құрметті ресми емес стиль аяқталуы; тұжырым, шақыру, сұрақ сияқты түрлі сөйлемдерде қолданылады.",
      "descRu": "Окончание вежливого разговорного стиля; используется в разных видах предложений: утверждение, побуждение, вопрос и т.д.",
      "descZh": "敬语非正式的对话体结尾；用于陈述、请求、疑问等多种句子。",
      "ruleKk": "Қағида: етістік/сын есім түбірі а немесе о дауыстысымен аяқталса -아, қалған жағдайда -е жалғанады; -하다 етістіктеріне -아/-е + 요: 공부하다 → 공부해요.",
      "ruleRu": "Если корень глагола/прилагательного оканчивается на гласную а или о, прибавляется -а; в остальных случаях — -е; к глаголам -하다 прибавляется -아/-е + 요: 공부하다 → 공부해요.",
      "ruleZh": "动词/形容词词干以元音 а 或 о 结尾时加 -아，其余情况加 -е；-하다 型动词加 -아/-е + 요：공부하다 → 공부해요。",
      "examples": [
        {
          "ko": "저는 쉬어요.",
          "kk": "Мен демалыс аламын.",
          "ru": "Я отдыхаю.",
          "zh": "我在休息。"
        },
        {
          "ko": "예스볼 씨는 지금 자요.",
          "kk": "Есбол қазір ұйықтап жатыр.",
          "ru": "Есбол сейчас спит.",
          "zh": "叶斯波正在睡觉。"
        },
        {
          "ko": "마지나 씨는 공부해요.",
          "kk": "Мадина оқиды.",
          "ru": "Мадина учится.",
          "zh": "玛迪娜在学习。"
        }
      ]
    },
    {
      "pattern": "을/를",
      "nameKk": "Бұйым (объект) көрсеткіші",
      "nameRu": "Маркер объекта (дополнения)",
      "nameZh": "宾语标记助词",
      "descKk": "Зат есімге жалғанып, оның сөйлемде тікелей толықтырғыш (бұйым) ретінде шығатынын көрсетеді.",
      "descRu": "Присоединяется к существительному и показывает, что оно выступает в предложении в качестве прямого дополнения (объекта).",
      "descZh": "接在名词后，表示它在句中作直接宾语。",
      "ruleKk": "Қағида: сөз дауыссызбен (бадыммен) аяқталса -을, дауыстымен аяқталса -를 жалғанады.",
      "ruleRu": "Слово, оканчивающееся на согласную (бэчжим), получает -을; оканчивающееся на гласную — -를.",
      "ruleZh": "单词以辅音（收音）结尾时加 -을，以元音结尾时加 -를。",
      "examples": [
        {
          "ko": "예스볼 씨는 텔레비전을 봐요.",
          "kk": "Есбол теледидар қарап жатыр.",
          "ru": "Есбол смотрит телевизор.",
          "zh": "叶斯波在看电视。"
        },
        {
          "ko": "나기마 씨는 주스를 마셔요.",
          "kk": "Нағима шірне ішеді.",
          "ru": "Нагима пьёт сок.",
          "zh": "纳吉玛在喝果汁。"
        },
        {
          "ko": "카이라트 씨는 친구를 만나요.",
          "kk": "Қайрат досымен кездеседі.",
          "ru": "Кайрат встречается с другом.",
          "zh": "凯拉特和朋友见面。"
        }
      ]
    },
    {
      "pattern": "에서",
      "nameKk": "Іс-әрекет орны",
      "nameRu": "Место действия",
      "nameZh": "动作发生的场所",
      "descKk": "Іс-әрекет қай жерде орындалатынын (және қозғалыстың басталу нүктесін) білдіреді.",
      "descRu": "Показывает, где происходит действие (а также исходную точку движения).",
      "descZh": "表示动作进行的地方（以及移动的出发点）。",
      "ruleKk": "Қағида: орын + 에서 + етістік.",
      "ruleRu": "Место + 에서 + глагол.",
      "ruleZh": "场所 + 에서 + 动词。",
      "examples": [
        {
          "ko": "저는 도서관에서 책을 읽어요.",
          "kk": "Мен кітапханада кітап оқимын.",
          "ru": "Я читаю книгу в библиотеке.",
          "zh": "我在图书馆看书。"
        },
        {
          "ko": "마지나 씨는 서점에서 책을 사요.",
          "kk": "Мадина кітап дүкенінен кітап алады.",
          "ru": "Мадина покупает книгу в книжном магазине.",
          "zh": "玛迪娜在书店买书。"
        },
        {
          "ko": "유나는 극장에서 영화를 봐요.",
          "kk": "Юна театрда кино көреді.",
          "ru": "Юна смотрит фильм в кинотеатре.",
          "zh": "尤娜在电影院看电影。"
        }
      ]
    },
    {
      "pattern": "ㄷ 불규칙 용언",
      "nameKk": "「ㄷ」 ерекшелігі: ㄷ → ㄹ",
      "nameRu": "Особенность «ㄷ»: ㄷ → ㄹ",
      "nameZh": "「ㄷ」的不规则变化：ㄷ → ㄹ",
      "descKk": "Түбірі ㄷ-мен аяқталатын етістіктер алдында дауысты келсе, ㄷ → ㄹ-ге ауысады: 듣다→들어요, 걷다→걸어요. Бірақ 닫다, 받다, 믿다 өзгермейді.",
      "descRu": "У глаголов с корнем на ㄷ перед гласным ㄷ меняется на ㄹ: 듣다→들어요, 걷다→걸어요. Но 닫다, 받다, 믿다 не меняются.",
      "descZh": "词干以 ㄷ 结尾的动词，后面接元音时 ㄷ 变为 ㄹ：듣다→들어요，걷다→걸어요。但 닫다、받다、믿다 不变。",
      "ruleKk": "Қағида: 듣다 → 들어요, 걷다 → 걸어요; бірақ 닫다 → 닫아요, 받다 → 받아요 (өзгермейді).",
      "ruleRu": "듣다 → 들어요, 걷다 → 걸어요; но 닫다 → 닫아요, 받다 → 받아요 (не меняются).",
      "ruleZh": "듣다 → 들어요，걷다 → 걸어요；但 닫다 → 닫아요，받다 → 받아요（不变）。",
      "examples": [
        {
          "ko": "저는 음악을 들어요.",
          "kk": "Мен музыка тыңдаймын.",
          "ru": "Я слушаю музыку.",
          "zh": "我在听音乐。"
        },
        {
          "ko": "나기마 씨는 공원에서 걸어요.",
          "kk": "Нағима паркта серуендеп жүреді.",
          "ru": "Нагима гуляет в парке.",
          "zh": "纳吉玛在公园散步。"
        },
        {
          "ko": "카이라트 씨는 창문을 닫아요.",
          "kk": "Қайрат терезені жабады.",
          "ru": "Кайрат закрывает окно.",
          "zh": "凯拉特关窗户。"
        }
      ]
    }
  ],
  "dialogue": {
    "titleKk": "Бүгін не істейсіз?",
    "titleRu": "Что вы делаете сегодня?",
    "titleZh": "你今天做什么？",
    "lines": [
      {
        "who": "마지나",
        "ko": "예스볼 씨, 오늘 무엇을 해요?",
        "kk": "Есбол, бүгін не істейсіз?",
        "ru": "Есбол, что ты сегодня делаешь?",
        "zh": "叶斯波，你今天做什么？"
      },
      {
        "who": "예스볼",
        "ko": "친구를 만나요.",
        "kk": "Досыммен кездесемін.",
        "ru": "Встречаюсь с другом.",
        "zh": "和朋友见面。"
      },
      {
        "who": "마지나",
        "ko": "어디에서 친구를 만나요?",
        "kk": "Досыңмен қай жерде кездесесің?",
        "ru": "Где ты встречаешься с другом?",
        "zh": "你在哪里和朋友见面？"
      },
      {
        "who": "예스볼",
        "ko": "공원에서 친구를 만나요.",
        "kk": "Паркта досыммен кездесемін.",
        "ru": "Встречаюсь с другом в парке.",
        "zh": "在公园和朋友见面。"
      }
    ]
  },
  "cultureKk": "Бос уақытта корейлер ән айту бөлмесіне (nogaebang) барып, үйде теледидар қарап, театрда кино көріп, паркта серуендеп, интернет пайдаланып, корейлік жылы бөлмеге (чжимjilbang) барып, тауға шығып (deongsan), достарымен ішуге барып отырады.",
  "cultureRu": "В свободное время корейцы ходят в караоке-комнату (노래방), смотрят телевизор дома, ходят в кино, гуляют в парке, пользуются интернетом, ходят в корейскую комнату с подогревом (찜질방), поднимаются в горы (등산) и ходят выпить с друзьями.",
  "cultureZh": "闲暇时，韩国人常去唱歌的包间（노래방）、在家看电视、在电影院看电影、在公园散步、上网、去韩国汗蒸房（찜질방）、登山（등산）、和朋友出去喝酒。",
