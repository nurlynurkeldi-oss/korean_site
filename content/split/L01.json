  "grammar": [
    {
      "pattern": "-이에요/예요",
      "nameKk": "Құрметті стильдегі сөйлем аяқталуы (теңдік)",
      "nameRu": "Окончание вежливого стиля (суждение)",
      "nameZh": "敬体终结词尾（判断句）",
      "descKk": "Құрметті әңгімелесу стилінде заттың немесе адамның кім/не екенін айтады. Сұрақ сөйлемінде аяғында интонация жоғарылайды.",
      "descRu": "В вежливом диалоговом стиле обозначает, кем/чем является кто-либо или что-либо. В вопросительном предложении интонация повышается в конце.",
      "descZh": "表示某人/某物是什么，用于敬语对话体。疑问句句尾语调升高。",
      "ruleKk": "Қағида: сөз дауыссызбен (бадыммен) аяқталса -이에요, дауыстымен аяқталса -예요 жалғанады.",
      "ruleRu": "Слово, оканчивающееся на согласную (бэчжим), получает -이에요; оканчивающееся на гласную — -예요.",
      "ruleZh": "单词以辅音（收音）结尾时加 -이에요，以元音结尾时加 -예요。",
      "examples": [
        {
          "ko": "의사예요.",
          "kk": "(ол) дәрігер.",
          "ru": "(он) врач.",
          "zh": "(他)是医生。"
        },
        {
          "ko": "한국 사람이에요.",
          "kk": "(ол) корей.",
          "ru": "(он) кореец.",
          "zh": "(他)是韩国人。"
        },
        {
          "ko": "저는 마지나예요.",
          "kk": "Мен — Мадина.",
          "ru": "Мен — Мадина.",
          "zh": "我是玛迪娜。"
        },
        {
          "ko": "제 이름은 나기마예요.",
          "kk": "Менің атым — Нағима.",
          "ru": "Моё имя — Нагима.",
          "zh": "我的名字是纳吉玛。"
        }
      ]
    },
    {
      "pattern": "은/는",
      "nameKk": "Тақырып көрсеткіші",
      "nameRu": "Частица-маркер темы",
      "nameZh": "主题标记助词",
      "descKk": "Сөйлемнің тақырыбын (ақпарат беріліп отырған ең маңызды мүшені) көрсетеді. Зат есімге жалғанады.",
      "descRu": "Обозначает тему предложения (самый важный член, о котором сообщается информация). Присоединяется к существительному.",
      "descZh": "表示句子的主题（正在描述的最重要的成分），接在名词后面。",
      "ruleKk": "Қағида: сөз дауыссызбен (бадыммен) аяқталса -은, дауыстымен аяқталса -는 жалғанады.",
      "ruleRu": "Слово, оканчивающееся на согласную (бэчжим), получает -은; оканчивающееся на гласную — -는.",
      "ruleZh": "单词以辅音（收音）结尾时加 -은，以元音结尾时加 -는。",
      "examples": [
        {
          "ko": "저는 마지나예요.",
          "kk": "Мен — Мадина. (мен — тақырып)",
          "ru": "Мен — Мадина. (я — тема)",
          "zh": "我是玛迪娜。（“我”是主题）"
        },
        {
          "ko": "제 이름은 나기마예요.",
          "kk": "Менің атым — Нағима.",
          "ru": "Моё имя — Нагима.",
          "zh": "我的名字是纳吉玛。"
        },
        {
          "ko": "카이라트는 회사원이에요.",
          "kk": "Қайрат — офис қызметкері.",
          "ru": "Кайрат — офисный работник.",
          "zh": "凯拉特是办公室职员。"
        },
        {
          "ko": "예스볼은 카자흐스탄 사람이에요.",
          "kk": "Есбол — қазақстандық.",
          "ru": "Есбол — казахстанец.",
          "zh": "叶斯波是哈萨克斯坦人。"
        }
      ]
    }
